{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "root": true,
  "files": {
    "includes": ["**", "!node_modules", "!dist", "!coverage", "!school-assistance", "!**/*.min.js"],
    "ignoreUnknown": true
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 120,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "warn",
        "noExplicitAny": "warn",
        "noShadowRestrictedNames": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "useConst": "error",
        "noNegationElse": "warn",
        "useImportType": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": { "patterns": [{ "group": ["@/**"] }] }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
